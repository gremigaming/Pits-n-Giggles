[Unit]
Description=Pits n' Giggles Championship Tracker
After=network.target

[Service]
Type=simple
User=championship
WorkingDirectory=/opt/championship-tracker
ExecStart=/opt/championship-tracker/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
